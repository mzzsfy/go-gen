package routers

import (
	"net/http"
	"reflect"
	"strings"
)

type Binder interface {
	BindMultipleMap(string, any, map[string][]string) error
	BindBody(any, *http.Request, Ctx) error
}

func ToBindF[T any](structPointer *T, _ func(Ctx) any, funcName string) func(ctx Ctx) any {
	return toBind[T](structPointer, funcName)
}

func toBind[T any](structPointer *T, funcName string) func(ctx Ctx) any {
	t := reflect.TypeOf(structPointer)
	m, ok := t.MethodByName(funcName)
	if !ok {
		panic("未找到方法" + funcName + ",请确定方法参数为指针")
	}
	// 值接收者方法同时存在于T与*T方法集,指针接收者只在*T;故T能查到该方法即为值接收者
	// 值接收者下 m.Func.Interface().(func(*T,...)) 断言会在首次请求 panic
	if _, ok := t.Elem().MethodByName(funcName); ok {
		panic(funcName + " 必须是指针接收者(*" + t.Elem().Name() + ") " + funcName + "(),当前为(" + t.Elem().Name() + ") " + funcName + "()")
	}
	tags := findTags(t.Elem())
	// 预计算 bind 函数链, 避免每请求重复 map 查找
	var binders []func(any, Ctx) error
	for _, s := range tags {
		if f := DefaultBindHandlerByTag[s]; f != nil {
			binders = append(binders, f)
		}
	}
	needValidate := len(binders) > 0
	var lifeCycleCaller, _ = any(structPointer).(LifeCycleManager[T])
	if lifeCycleCaller != nil {
		t1 := lifeCycleCaller.GetNewSelf()
		if t1 == nil {
			panic("自定义生命周期管理器返回为nil")
		}
		lifeCycleCaller.ReclaimSelf(t1)
	}
	f, ok := (m.Func.Interface()).(func(*T, Ctx) any)
	if !ok {
		panic(funcName + " 方法签名不匹配, 期望 func(*" + t.Elem().Name() + ", Ctx) any")
	}
	return func(context Ctx) any {
		var obj *T
		if lifeCycleCaller != nil {
			obj = lifeCycleCaller.GetNewSelf()
			defer lifeCycleCaller.ReclaimSelf(obj)
		} else {
			newObj := *structPointer
			obj = &newObj
		}
		for _, binder := range binders {
			err := binder(obj, context)
			if err != nil {
				context.Status(400)
				context.SetError(CtxError{
					Ctx: "Bind",
					Err: err,
				})
				return context.Error()
			}
		}
		if needValidate {
			err := context.Validate(obj)
			if err != nil {
				context.Status(400)
				context.SetError(CtxError{
					Ctx: "Validate",
					Err: err,
				})
				return context.Error()
			}
		}
		return f(obj, context)
	}
}

// findTags 递归收集结构体所有字段的 tag 名称, 使用 map 去重
func findTags(t reflect.Type) []string {
	seen := make(map[string]struct{})
	collectTags(t, seen)
	result := make([]string, 0, len(seen))
	for tag := range seen {
		result = append(result, tag)
	}
	return result
}

func collectTags(t reflect.Type, seen map[string]struct{}) {
	for i := 0; i < t.NumField(); i++ {
		field := t.Field(i)
		if tag := field.Tag; tag != "" {
			for _, s := range strings.Split(string(tag), " ") {
				name := strings.SplitN(s, ":", 2)[0]
				if name != "" {
					seen[name] = struct{}{}
				}
			}
		}
		if field.Anonymous {
			ft := field.Type
			if ft.Kind() == reflect.Pointer {
				ft = ft.Elem()
			}
			collectTags(ft, seen)
		}
	}
}

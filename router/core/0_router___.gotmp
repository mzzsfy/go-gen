package routers

import "slices"

type Router interface {
	Router(group string, handler func(Ctx) any, relativePath string, methods ...string)
	GroupMiddleware(group string, order int, middleware func(next func(), ctx Ctx))
	OnError(func(Ctx, error) error)
	ErrorResultHandler(func(Ctx, error) (bool, error))
	ResultHandler(func(ctx Ctx, res any))
	ValidateHandler(Validator)
	Logger(Logger)
}

type LifeCycleManager[T any] interface {
	GetNewSelf() *T
	ReclaimSelf(*T)
}

// middlewareEntry 内部中间件条目, 按 order 排序执行
type middlewareEntry struct {
	order int
	fn    func(next func(), ctx Ctx)
}

type baseRouter struct {
	validator       Validator
	resultHandler   func(Ctx, any)
	errorHandler    func(Ctx, error) (bool, error)
	logger          Logger
	onError         func(Ctx, error) error
	groupMiddleware map[string][]middlewareEntry
}

func (r *baseRouter) addMiddleware(group string, order int, fn func(next func(), ctx Ctx)) {
	if r.groupMiddleware == nil {
		r.groupMiddleware = map[string][]middlewareEntry{}
	}
	mws := append(r.groupMiddleware[group], middlewareEntry{order, fn})
	slices.SortFunc(mws, func(a, b middlewareEntry) int {
		return a.order - b.order
	})
	r.groupMiddleware[group] = mws
}

func (r *baseRouter) getMiddleware(group string) []middlewareEntry {
	return r.groupMiddleware[group]
}

// runWithMiddleware 按 order 排序后的中间件链执行, 最后调用 handler
func (r *baseRouter) runWithMiddleware(mws []middlewareEntry, handler func(), ctx Ctx) {
	if len(mws) == 0 {
		handler()
		return
	}
	idx := 0
	handlerDone := false
	var next func()
	next = func() {
		if idx >= len(mws) {
			if !handlerDone {
				handlerDone = true
				handler()
			}
			return
		}
		mw := mws[idx]
		idx++
		mw.fn(next, ctx)
	}
	next()
}

func (r *baseRouter) Logger(l Logger) {
	r.logger = l
}

func (r *baseRouter) getLogger(ctx Ctx) Logger {
	if r.logger != nil {
		return r.logger
	}
	return DefaultLogger
}

func (r *baseRouter) ErrorResultHandler(f func(Ctx, error) (bool, error)) {
	r.errorHandler = f
}

func (r *baseRouter) handleResultError(ctx Ctx, err error) (bool, error) {
	if r.errorHandler != nil {
		return r.errorHandler(ctx, err)
	} else if DefaultErrorResultHandler != nil {
		return DefaultErrorResultHandler(ctx, err)
	}
	return false, err
}

func (r *baseRouter) OnError(f func(Ctx, error) error) {
	r.onError = f
}

func (r *baseRouter) handleError(ctx Ctx, err error) error {
	if r.onError != nil {
		return r.onError(ctx, err)
	}
	return err
}

func (r *baseRouter) ResultHandler(f func(ctx Ctx, res any)) {
	r.resultHandler = f
}

func (r *baseRouter) handleResult(ctx Ctx, res any) {
	if r.resultHandler != nil {
		r.resultHandler(ctx, res)
	} else if DefaultResultHandler != nil {
		DefaultResultHandler(ctx, res)
	} else {
		ctx.String(500, "no result handler")
	}
}

func (r *baseRouter) ValidateHandler(validator Validator) {
	r.validator = validator
}

func (r *baseRouter) Validate(obj any) error {
	if r.validator != nil {
		return r.validator.ValidateStruct(obj)
	} else if DefaultValidator != nil {
		return DefaultValidator.ValidateStruct(obj)
	}
	return nil
}

